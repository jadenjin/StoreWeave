<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.jdc</groupId>
        <artifactId>storeweave-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>storeweave-example-spring-boot</artifactId>
    <name>StoreWeave :: Example :: Spring Boot</name>
    <dependencies>
        <dependency>
            <groupId>com.jdc</groupId>
            <artifactId>storeweave-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jdc</groupId>
            <artifactId>storeweave-provider-local</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jdc</groupId>
            <artifactId>storeweave-provider-s3</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jdc</groupId>
            <artifactId>storeweave-provider-minio</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jdc</groupId>
            <artifactId>storeweave-provider-aliyun-oss</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jdc</groupId>
            <artifactId>storeweave-provider-tencent-cos</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jdc</groupId>
            <artifactId>storeweave-provider-huawei-obs</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jdc</groupId>
            <artifactId>storeweave-provider-ftp</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jdc</groupId>
            <artifactId>storeweave-provider-sftp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
